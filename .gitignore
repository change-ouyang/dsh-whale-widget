# ==========================================
# 运行时数据 / 凭据：绝不入库
# 这些文件由本机在 $DSH_HOME 生成，或属于用户专属数据，
# 提交既是隐私泄露也会污染用户环境。
# ==========================================
dshw-*.json
dshw-*.json.bak*
.dshw-usage-arc
hive.json
.credentials.yaml
.env
.env.*
gh-token.txt

# 用户生成的资源目录
whale-roles/
whale-audio/
whale-bubble-imgs/
sessions/

# 依赖与临时物
node_modules/
*.zip
*.log
*.bak
*.bak2
*.bak-devpaths
_patch_*.patch

# 打包产物（构建后生成，不入库）
*.tgz

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
